# Copy to ~/.config/control-plane/control-plane.env and restrict it to the service account.
PVE_HOST=proxmox.example.test
PVE_PORT=8006
PVE_NODE=proxmox-node
PVE_TOKEN_ID=control-plane@pve!api
PVE_TOKEN_SECRET=replace-with-a-Proxmox-API-token-secret

# TLS verification is on by default. Set the CA file when Proxmox uses a private CA.
PVE_TLS_VERIFY=true
# PVE_TLS_CA_FILE=~/.config/control-plane/proxmox-ca.pem

# Generate with: openssl rand -hex 32
CONTROL_PLANE_SESSION_SECRET=replace-with-at-least-32-random-bytes
CONTROL_PLANE_USERS_FILE=~/.config/control-plane/users.json

# The bundled systemd unit intentionally retains its existing all-interface bind.
# Restrict access with a firewall/private network, or explicitly override the host.
# CONTROL_PLANE_API_HOST=0.0.0.0
CONTROL_PLANE_API_PORT=8000

CONTROL_PLANE_SECURE_COOKIES=false

# FAMBAM22 is optional. Leave these blank until configured for your own host.
FAMBAM22_HOST=
FAMBAM22_PORT=25565
FAMBAM22_MAC=
FAMBAM22_SSH_USER=
FAMBAM22_SSH_KEY=~/.ssh/control-plane-fambam22

# Wonton26 RCON remains private and is never sent to browsers.
WONTON26_RCON_HOST=rcon.example.test
WONTON26_RCON_PORT=25575
WONTON26_RCON_PASSWORD=replace-with-the-RCON-password
# Required for whitelist operations; list protected Java usernames, comma-separated.
# Missing or invalid values disable all whitelist operations.
WONTON26_PROTECTED_PLAYERS=

# Backup automation is disabled by default; configure storage and node before enabling.
PVE_BACKUP_NODE=
PVE_BACKUP_VMID=104
PVE_BACKUP_STORAGE=
PVE_BACKUP_TIME=03:00
PVE_BACKUP_ENABLED=0

# Optional path for NAS usage reporting.
NAS_MOUNT_PATH=/mnt/nas
